{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "name": "patient_flat_v1",
  "status": "active",
  "resource": "Patient",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "active",
          "name": "active",
          "type": "boolean"
        },
        {
          "path": "identifier.first().system",
          "name": "identifier_system"
        },
        {
          "path": "identifier.first().value",
          "name": "identifier_value"
        },
        {
          "path": "iif(name.first().text.exists(), name.first().text, iif(name.first().given.first().exists() and name.first().family.exists(), name.first().given.first() & ' ' & name.first().family, name.first().given.first() & name.first().family))",
          "name": "name_display"
        },
        {
          "path": "name.first().family",
          "name": "family_name"
        },
        {
          "path": "name.first().given.first()",
          "name": "given_name"
        },
        {
          "path": "gender",
          "name": "gender"
        },
        {
          "path": "birthDate",
          "name": "birth_date",
          "type": "date"
        }
      ]
    }
  ]
}
