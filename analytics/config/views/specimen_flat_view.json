{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "text": "Gap-fill for the upstream default set (which ships no Specimen view); receivedTime feeds lab_result_fact_v1.receipt_to_release_minutes.",
  "name": "specimen_flat",
  "status": "active",
  "resource": "Specimen",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_id"
        },
        {
          "path": "accessionIdentifier.value",
          "name": "accession_number"
        },
        {
          "path": "status",
          "name": "specimen_status"
        },
        {
          "path": "collection.collected.ofType(dateTime)",
          "name": "collected_at",
          "type": "dateTime"
        },
        {
          "path": "receivedTime",
          "name": "received_at",
          "type": "dateTime"
        }
      ]
    },
    {
      "forEachOrNull": "type.coding",
      "column": [
        {
          "path": "code",
          "name": "type_code"
        },
        {
          "path": "system",
          "name": "type_sys"
        },
        {
          "path": "display",
          "name": "type_display"
        }
      ]
    }
  ]
}
