{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "text": "Gap-fill for the upstream default set (which ships no ServiceRequest view); the curated public.service_request_flat_v1 compatibility view collapses this to one row per request.",
  "name": "service_request_flat",
  "status": "active",
  "resource": "ServiceRequest",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_id"
        },
        {
          "path": "specimen.first().getReferenceKey(Specimen)",
          "name": "specimen_id"
        },
        {
          "path": "status",
          "name": "request_status"
        },
        {
          "path": "intent",
          "name": "request_intent"
        },
        {
          "path": "authoredOn",
          "name": "authored_at",
          "type": "dateTime"
        }
      ]
    },
    {
      "forEachOrNull": "code.coding",
      "column": [
        {
          "path": "code",
          "name": "code_code"
        },
        {
          "path": "system",
          "name": "code_sys"
        },
        {
          "path": "display",
          "name": "code_display"
        }
      ]
    }
  ]
}
