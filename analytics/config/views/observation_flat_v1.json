{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "name": "observation_flat_v1",
  "status": "active",
  "resource": "Observation",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_id"
        },
        {
          "path": "basedOn.first().getReferenceKey(ServiceRequest)",
          "name": "service_request_id"
        },
        {
          "path": "specimen.first().getReferenceKey(Specimen)",
          "name": "specimen_id"
        },
        {
          "path": "status",
          "name": "result_status"
        },
        {
          "path": "effective.ofType(dateTime)",
          "name": "observed_at",
          "type": "dateTime"
        },
        {
          "path": "issued",
          "name": "issued_at",
          "type": "instant"
        },
        {
          "path": "code.coding.first().system",
          "name": "test_code_system"
        },
        {
          "path": "code.coding.first().code",
          "name": "test_code"
        },
        {
          "path": "code.coding.first().display",
          "name": "test_name"
        },
        {
          "path": "value.ofType(Quantity).value",
          "name": "result_value",
          "type": "decimal"
        },
        {
          "path": "value.ofType(Quantity).unit",
          "name": "result_unit"
        },
        {
          "path": "value.ofType(Quantity).system",
          "name": "result_unit_system"
        },
        {
          "path": "value.ofType(Quantity).code",
          "name": "result_unit_code"
        }
      ]
    }
  ]
}
