{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "name": "diagnostic_report_flat_v1",
  "status": "active",
  "resource": "DiagnosticReport",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_id"
        },
        {
          "path": "basedOn.first().getReferenceKey(ServiceRequest)",
          "name": "service_request_id"
        },
        {
          "path": "specimen.first().getReferenceKey(Specimen)",
          "name": "specimen_id"
        },
        {
          "path": "result.first().getReferenceKey(Observation)",
          "name": "first_observation_id"
        },
        {
          "path": "status",
          "name": "report_status"
        },
        {
          "path": "effective.ofType(dateTime)",
          "name": "effective_at",
          "type": "dateTime"
        },
        {
          "path": "issued",
          "name": "issued_at",
          "type": "instant"
        },
        {
          "path": "code.coding.first().system",
          "name": "test_code_system"
        },
        {
          "path": "code.coding.first().code",
          "name": "test_code"
        },
        {
          "path": "code.coding.first().display",
          "name": "test_name"
        }
      ]
    }
  ]
}
