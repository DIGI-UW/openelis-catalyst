#!/bin/bash
# Auto-format hook: Runs Ruff on staged Python files before commit
# Mirrors the checks run by .github/workflows/ci.yml so commits don't fail CI on formatting/lint.

set -e

echo "🎨 Running auto-formatters on staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "  → No staged files to format"
    exit 0
fi

PYTHON_FILES=$(echo "$STAGED_FILES" | grep -E '^(catalyst-(agents|gateway|mcp))/.*\.py$' || true)

if [ -z "$PYTHON_FILES" ]; then
    echo "  → No Python files staged in catalyst-* projects"
    exit 0
fi

echo "  → Formatting $(echo "$PYTHON_FILES" | wc -l) Python file(s) (ruff format)..."
echo "$PYTHON_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        if echo "$file" | grep -q '^catalyst-agents/'; then
            (cd catalyst-agents && uv run ruff format "../$file" 2>/dev/null) || true
        elif echo "$file" | grep -q '^catalyst-gateway/'; then
            (cd catalyst-gateway && uv run ruff format "../$file" 2>/dev/null) || true
        elif echo "$file" | grep -q '^catalyst-mcp/'; then
            (cd catalyst-mcp && uv run ruff format "../$file" 2>/dev/null) || true
        fi
    fi
done

# Re-stage formatted files
echo "$PYTHON_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "  → Linting staged Python file(s) (ruff check)..."
for project in catalyst-agents catalyst-gateway catalyst-mcp; do
    PROJECT_FILES=$(echo "$PYTHON_FILES" | grep "^$project/" || true)
    if [ -n "$PROJECT_FILES" ]; then
        REL_PATHS=()
        while IFS= read -r file; do
            rel_path=${file#"$project/"}
            REL_PATHS+=("$rel_path")
        done <<< "$PROJECT_FILES"
        if (cd "$project" && uv run ruff check "${REL_PATHS[@]}" --fix); then
            : # lint passed
        else
            echo "❌ Ruff check failed in $project. Fix lint errors before committing."
            exit 1
        fi
        echo "$PROJECT_FILES" | while IFS= read -r file; do
            if [ -f "$file" ]; then
                git add "$file"
            fi
        done
    fi
done

echo "✅ Formatting complete!"
exit 0
