# Copy this file to .env for local development.

# Ports
GATEWAY_PORT=8000
CATALYST_UI_PORT=3000
ANALYTICS_DB_PORT=15433
DATA_PIPES_PORT=8090
OPENELIS_HTTPS_PORT=8443
HAPI_HTTPS_PORT=8444

# MCP endpoint URL (Catalyst -> MCP)
MCP_URL=http://localhost:9102

# Legacy MCP-path table allowlist; this does not limit the query workbench's
# role-readable runtime catalog.
# (comma-separated, default = minimal non-PHI profile)
# Default includes: test, test_section, analyte, method, panel, panel_item,
# type_of_sample, type_of_test_result, unit_of_measure, dictionary,
# dictionary_category, status_of_sample
MCP_ALLOWED_TABLES=

# Database (M1+ - not used in M0.0)
MCP_DB_ENABLED=false
MCP_DB_HOST=db.openelis.org
MCP_DB_PORT=5432
MCP_DB_NAME=clinlims
MCP_DB_USER=catalyst_schema_reader
MCP_DB_PASSWORD=
MCP_DB_SCHEMA=clinlims

# med-agent-hub (report generation; host :8082 avoids the OpenELIS app on :8080)
MED_AGENT_HUB_PORT=8082
MED_AGENT_HUB_BASE_URL=http://localhost:8082
# Hub model router (the host's OpenAI-compatible server, reached from Docker)
HUB_LLM_BASE_URL=http://host.docker.internal:1234
HUB_LLM_PROVIDER=openai-compatible

# Local Superset dashboard renderer (demo credentials; never use in production)
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=catalyst-local-demo-secret-key-change-before-shared-use
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@catalyst.local
SUPERSET_METADATA_DB=catalyst_superset_metadata
SUPERSET_METADATA_USER=catalyst_superset
SUPERSET_METADATA_PASSWORD=demo-superset-metadata-change-me
HUB_LLM_API_KEY=
# Optional Querystore (OpenMRS patient charts); inline chart works without these
QUERYSTORE_BASE_URL=
QUERYSTORE_USERNAME=
QUERYSTORE_PASSWORD=

# Focused MVP assembly
OPENELIS_VERSION=3.2.1.11
OPENELIS_DOCKER_REF=f118d0ae778a30028c16be2af549843ec166f655
CATALYST_ANALYTICS_DSN=postgresql://catalyst_readonly:demo-readonly-change-me@localhost:15433/catalyst_analytics
CATALYST_EXECUTION_LEASE_SECONDS=60
CATALYST_HUB_TIMEOUT_SECONDS=360
# The MVP uses the real external router only. Hub owns the exact writer/reviewer
# models, prompts, and sampling knobs in its Catalyst query profile.
MVP_MODEL_BACKEND=external
MVP_EXTERNAL_ROUTER_URL=http://host.docker.internal:1234
MVP_EXTERNAL_PROFILE_ID=catalyst-query-e4b-qwen14b
DATA_PIPES_MAX_HEAP=2g
