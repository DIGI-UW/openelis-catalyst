# Copy this file to .env for local development.

# LLM provider selection: lmstudio | gemini
CATALYST_LLM_PROVIDER=lmstudio

# LM Studio configuration
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Gemini configuration (for E2E testing)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ports
GATEWAY_PORT=8000
ROUTER_PORT=9100
CATALYST_AGENT_PORT=9101
MCP_PORT=9102
CATALYST_UI_PORT=3000
ANALYTICS_DB_PORT=15433
DATA_PIPES_PORT=8090
OPENELIS_HTTPS_PORT=8443
HAPI_HTTPS_PORT=8444

# A2A endpoint URLs (Router -> Catalyst)
CATALYST_ROUTER_URL=http://localhost:9100
CATALYST_AGENT_URL=http://localhost:9101

# MCP endpoint URL (Catalyst -> MCP)
MCP_URL=http://localhost:9102

# MCP table allowlist (comma-separated, default = minimal non-PHI profile)
# Default includes: test, test_section, analyte, method, panel, panel_item,
# type_of_sample, type_of_test_result, unit_of_measure, dictionary,
# dictionary_category, status_of_sample
MCP_ALLOWED_TABLES=

# Database (M1+ - not used in M0.0)
MCP_DB_ENABLED=false
MCP_DB_HOST=db.openelis.org
MCP_DB_PORT=5432
MCP_DB_NAME=clinlims
MCP_DB_USER=catalyst_schema_reader
MCP_DB_PASSWORD=
MCP_DB_SCHEMA=clinlims

# med-agent-hub (report generation; host :8082 avoids the OpenELIS app on :8080)
MED_AGENT_HUB_PORT=8082
# Hub model router (llama.cpp or other OpenAI-compatible server on the host)
HUB_LLM_BASE_URL=http://host.docker.internal:8077
HUB_LLM_API_KEY=
# Optional Querystore (OpenMRS patient charts); inline chart works without these
QUERYSTORE_BASE_URL=
QUERYSTORE_USERNAME=
QUERYSTORE_PASSWORD=

# Focused MVP assembly
OPENELIS_VERSION=3.2.1.11
CATALYST_ANALYTICS_DSN=postgresql://catalyst_readonly:demo-readonly-change-me@localhost:15433/catalyst_analytics
MVP_HUB_LLM_BASE_URL=http://model-router:8077
MVP_MODEL_REPO=bartowski/Qwen2.5-Coder-1.5B-Instruct-GGUF
# The profile alias remains stable while the demo uses a small local coder.
MVP_MODEL_FILE=Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf
MVP_MODEL_SHA256=f530705d447660a4336c329981af164b471b60b974b1d808d57e8ec9fe23b239
MVP_MODEL_CONTEXT=8192
DATA_PIPES_MAX_HEAP=2g
