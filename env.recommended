# Copy this file to .env for local development.

# LLM provider selection: lmstudio | gemini
CATALYST_LLM_PROVIDER=lmstudio

# LM Studio configuration
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Gemini configuration (for E2E testing)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ports
GATEWAY_PORT=8000
ROUTER_PORT=9100
CATALYST_AGENT_PORT=9101
MCP_PORT=9102

# A2A endpoint URLs (Router -> Catalyst)
CATALYST_ROUTER_URL=http://localhost:9100
CATALYST_AGENT_URL=http://localhost:9101

# MCP endpoint URL (Catalyst -> MCP)
MCP_URL=http://localhost:9102

# MCP table allowlist (comma-separated, default = minimal non-PHI profile)
# Default includes: test, test_section, analyte, method, panel, panel_item,
# type_of_sample, type_of_test_result, unit_of_measure, dictionary,
# dictionary_category, status_of_sample
MCP_ALLOWED_TABLES=

# Database (M1+ - not used in M0.0)
MCP_DB_ENABLED=false
MCP_DB_HOST=db.openelis.org
MCP_DB_PORT=5432
MCP_DB_NAME=clinlims
MCP_DB_USER=catalyst_schema_reader
MCP_DB_PASSWORD=
MCP_DB_SCHEMA=clinlims

# OE2 embedded FHIR provider (feature 011 — FHIR sidecar POC).
# This is the PRIMARY FHIR surface, not OE2's separate HAPI sidecar container,
# which requires a client TLS certificate this POC does not provision (see
# specs/011-catalyst-fhir-sidecar-poc/research.md item 5). If you followed the
# harness's OpenELIS-Global-2 sibling-checkout quickstart and remapped the
# webapp's HTTPS port, set OE2_FHIR_BASE_URL to match.
OE2_FHIR_BASE_URL=https://localhost:18443/OpenELIS-Global/fhir
OE2_FHIR_USERNAME=admin
OE2_FHIR_PASSWORD=adminADMIN!
OE2_FHIR_TIMEOUT_S=15
OE2_FHIR_VERIFY_TLS=false

# OE2 HAPI FHIR sidecar (Story 4 parity probe only — not the answer path).
# Expected to fail with a client-certificate TLS error; that failure is the
# gap-log finding itself, not a misconfiguration. See research.md item 5.
OE2_HAPI_BASE_URL=https://localhost:8444/fhir
OE2_HAPI_TIMEOUT_S=10
OE2_HAPI_VERIFY_TLS=false
