# Environment + secrets
.env
.env.local

# OpenELIS docker deployment (cloned by scripts/bootstrap-openelis.sh)
.openelis-docker/

# Report engine (cloned by scripts/bootstrap-med-agent-hub.sh)
.med-agent-hub/

# OHS analytics pipeline (cloned by scripts/bootstrap-fhir-data-pipes.sh)
.fhir-data-pipes/

# Local demo model files
.models/

# tdd-guard local judge state (machine-local, not evidence)
**/.claude/tdd-guard/data/

# Logs
logs/
*.log

# Catalyst-owned local Superset outbox, receipts, locks, and generated state
/runtime/superset/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/

# uv
.uv-cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build metadata produced by an editable install.
*.egg-info/

# Demo run output. The specs write these while running, and the MVP
# wrapper refuses to act on a dirty submodule -- so leaving them
# untracked makes the demo break the importer it then calls.
**/demo-milestones/
**/demo-screenshots/
**/test-results/
**/playwright-report/
