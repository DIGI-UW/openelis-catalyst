{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/catalyst/contracts/catalyst-policy-outcome-v1.schema.json",
  "title": "Catalyst deterministic policy rejection",
  "description": "Catalyst-owned rejection emitted after a hub-ready query fails local deterministic policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "deploymentMode",
    "status",
    "errorCode",
    "message",
    "violations",
    "catalystTraceId"
  ],
  "properties": {
    "contractVersion": {
      "const": "catalyst.policy.outcome.v1"
    },
    "deploymentMode": {
      "const": "demo"
    },
    "status": {
      "const": "rejected"
    },
    "errorCode": {
      "const": "query_policy_rejected"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "catalystTraceId": {
      "type": "string",
      "minLength": 1
    }
  }
}
