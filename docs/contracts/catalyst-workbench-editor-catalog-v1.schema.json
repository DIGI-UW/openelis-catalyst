{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/catalyst/contracts/catalyst-workbench-editor-catalog-v1.schema.json",
  "title": "Catalyst manual workbench editor catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "catalogVersion",
    "schemaVersion",
    "dialect",
    "schemas"
  ],
  "properties": {
    "contractVersion": {
      "const": "catalyst.workbench.editor-catalog.v1"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "dialect": {
      "const": "postgresql"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/schema"
      }
    }
  },
  "$defs": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "views"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifiedName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
        },
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "enum": [
            "table",
            "partitioned-table",
            "view",
            "materialized-view",
            "foreign-table",
            "relation"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "logicalType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "logicalType": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "date-time",
            "time",
            "interval",
            "json",
            "array",
            "binary"
          ]
        },
        "databaseType": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "unitColumn": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    }
  }
}
