{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/catalyst/contracts/catalyst-workbench-session-v1.schema.json",
  "title": "Catalyst manual workbench session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sessionId",
    "question",
    "profileId",
    "datasetId",
    "datasetVersion",
    "catalogVersion",
    "currentVersionId",
    "browserState",
    "provenance",
    "status",
    "createdAt",
    "updatedAt",
    "versions",
    "currentVersion",
    "validations",
    "latestValidation",
    "executions"
  ],
  "properties": {
    "contractVersion": {"const": "catalyst.workbench.session.v1"},
    "sessionId": {"type": "string", "format": "uuid"},
    "question": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetVersion": {"type": "string", "minLength": 1},
    "catalogVersion": {"type": "string", "minLength": 1},
    "currentVersionId": {"type": ["string", "null"]},
    "browserState": {"type": "object"},
    "provenance": {"type": "object"},
    "status": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "versions": {"type": "array", "items": {"type": "object"}},
    "currentVersion": {"type": ["object", "null"]},
    "validations": {"type": "array", "items": {"type": "object"}},
    "latestValidation": {"type": ["object", "null"]},
    "executions": {"type": "array", "items": {"type": "object"}}
  }
}
