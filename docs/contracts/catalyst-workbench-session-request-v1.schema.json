{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/catalyst/contracts/catalyst-workbench-session-request-v1.schema.json",
  "title": "Catalyst manual workbench session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "deploymentMode", "question"],
  "properties": {
    "contractVersion": {"const": "catalyst.workbench.session.request.v1"},
    "deploymentMode": {"const": "demo"},
    "question": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "pattern": "^catalyst-query-", "minLength": 1},
    "dataSourceId": {"type": "string", "minLength": 1},
    "browserState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expanded": {"type": "boolean"},
        "testName": {"type": "string"},
        "patientId": {"type": "string"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "offset": {"type": "integer", "minimum": 0}
      }
    }
  }
}
